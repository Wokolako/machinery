# PostgreSQL 13 on this machine listens on port 5433 (PostgreSQL 18 is on 5432).
# Replace YOUR_PASSWORD with the postgres user's password. The database
# "assetyield" is created by `npm run db:setup` if it doesn't exist.
# Without DATABASE_URL the API still starts, but every data endpoint answers
# 503 and the website shows its built-in dummy data instead.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/assetyield

# Neon: set both URLs from the Neon console. The API and db:setup use the
# direct one, because the pooler rejects the search_path startup option.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

HOST=127.0.0.1
PORT=4000

# Optional: enables GET /api/pilot-requests (send it as the X-API-Key header).
# Use a long random string, at least 16 characters.
# ADMIN_API_KEY=

# Optional tuning (defaults shown).
# DB_POOL_MAX=10
# PILOT_RATE_LIMIT=10
# PILOT_RATE_WINDOW_MINUTES=10
# LOG_REQUESTS=true
