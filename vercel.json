{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "app": {
            "root": ".",
            "framework": "nextjs",
            "bindings": [
                {
                    "type": "service",
                    "service": "api",
                    "format": "url",
                    "env": "API_URL"
                }
            ]
        },
        "api": {
            "root": "api",
            "framework": "express",
            "entrypoint": "src/server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "api"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "app"
            }
        }
    ]
}
